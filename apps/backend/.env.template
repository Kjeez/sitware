DATABASE_URL=postgres://sitware:sitware-local@localhost:5432/sitware
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:8000,http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
JWT_SECRET=replace-with-a-long-random-value
COOKIE_SECRET=replace-with-a-different-long-random-value

# Public storefront URL, used in email links and as the Google login callback base.
STOREFRONT_URL=http://localhost:8000
# Public URL of this backend (admin dashboard and print-storefront-env). Optional locally.
MEDUSA_BACKEND_URL=http://localhost:9000

# ---- Shipping (rupees), applied by src/scripts/setup-checkout.ts ----
# TODO(owner): confirm the real values. Re-run setup-checkout after changing them.
SHIPPING_FLAT_FEE=
# Orders whose item total reaches this ship free. Leave blank for no free shipping.
FREE_SHIPPING_THRESHOLD=
# Price of the Return Pickup option. Defaults to 0.
RETURN_PICKUP_FEE=

# ---- Razorpay (payment provider id: pp_razorpay_razorpay). Leave blank to run with COD only. ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to register in the Razorpay dashboard: <backend-url>/hooks/payment/razorpay_razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---- Google login. Authorized redirect URI in Google Cloud: <STOREFRONT_URL>/auth/google/callback ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Transactional email via Resend. Leave blank to log emails to the console instead. ----
RESEND_API_KEY=
# TODO(owner): the sending address, on a domain verified in Resend.
EMAIL_FROM=

# ---- Production only: leave blank locally ----
# Redis for cache, events, workflows and locking. Unset uses in-memory fallbacks.
REDIS_URL=
# S3-compatible file storage (Oracle Object Storage). Unset stores uploads on local disk.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "shared" (default), "server" or "worker".
MEDUSA_WORKER_MODE=
# "true" hides the admin dashboard on this instance.
DISABLE_MEDUSA_ADMIN=
