{
  "name": "sitware-commerce",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:local:up": "powershell -NoProfile -File scripts/local-db.ps1 start",
    "db:local:down": "powershell -NoProfile -File scripts/local-db.ps1 stop",
    "backend:dev": "turbo dev --filter=@sitware/backend",
    "storefront:dev": "turbo dev --filter=@sitware/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
