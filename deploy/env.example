# Copy to deploy/.env on the server and fill in every value. Never commit the real .env.
# Generate secrets with:  openssl rand -hex 32

# ---- Domains ----
# Public address of the API + admin dashboard (DNS A record -> this VM's public IP), e.g. api.<your-domain>
API_DOMAIN=
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=
# Where the storefront is served (Vercel), without a trailing slash. Used in email links and the
# Google login callback. During staging this is the temporary store address.
STOREFRONT_URL=

# ---- CORS: comma-separated origins allowed to call the API ----
# STORE_CORS and AUTH_CORS: the storefront origin(s). ADMIN_CORS: https://<API_DOMAIN>
STORE_CORS=
AUTH_CORS=
ADMIN_CORS=

# ---- Database (Postgres runs in Docker on this VM) ----
POSTGRES_USER=sitware
POSTGRES_PASSWORD=
POSTGRES_DB=sitware

# ---- Secrets ----
JWT_SECRET=
COOKIE_SECRET=

# ---- Shipping (rupees), applied by setup-checkout.js; re-run it after changing ----
# TODO(owner): confirmed values.
SHIPPING_FLAT_FEE=
# Blank = no free shipping.
FREE_SHIPPING_THRESHOLD=
RETURN_PICKUP_FEE=0

# ---- Oracle Object Storage (S3-compatible) for product images ----
# The bucket must be PUBLIC so images load on the site.
S3_BUCKET=
# e.g. ap-mumbai-1
S3_REGION=
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ENDPOINT=
# https://objectstorage.<region>.oraclecloud.com/n/<namespace>/b/<bucket>/o
S3_FILE_URL=
# Customer secret key (Profile -> Customer secret keys in the Oracle console)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Backups (a separate PRIVATE bucket; never the public media bucket) ----
BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=14

# ---- Email ----
# Transactional email via Resend (password reset, order linking, contact form). Blank = logged only.
RESEND_API_KEY=
# TODO(owner): sending address on a domain verified in Resend, e.g. Sitware <orders@your-domain>
EMAIL_FROM=
# TODO(owner): inbox for the storefront contact form. Blank turns the form off.
CONTACT_EMAIL=

# ---- Optional integrations ----
# Google login. Authorized redirect URI in Google Cloud: <STOREFRONT_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Razorpay (leave blank for Cash on Delivery only). Webhook URL to register in the Razorpay
# dashboard: https://<API_DOMAIN>/hooks/payment/razorpay_razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
